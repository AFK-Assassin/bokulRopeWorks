PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/bokul_rope_works
CLIENT_URL=http://localhost:5173

# Cryptographically strong secret key for signing JWTs (generate using `openssl rand -hex 32`)
JWT_SECRET=your_cryptographically_strong_random_jwt_secret_min_64_chars
JWT_EXPIRE=30d

# Seed Admin Credentials (used only during initial setup when zero admin accounts exist)
ADMIN_SEED_EMAIL=admin@bokulropeworks.com
ADMIN_SEED_PASSWORD=your_secure_admin_password_here

# Google Gemini API Key for Automated Quotation & Chat
GEMINI_API_KEY=your_gemini_api_key_here
